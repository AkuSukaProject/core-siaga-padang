ah,&lt;br&gt;tanpa celah dan tidak tumpang tindih." style="text;html=1;fillColor=#f8e8e8;strokeColor=none;align=left;verticalAlign=middle;spacingLeft=8;fontSize=10;fontFamily=Segoe UI;fontColor=#1e293b;whiteSpace=wrap;" vertex="1" parent="lengkap-tb_safe_zones"><mxGeometry y="30" width="411" height="36" as="geometry"/></mxCell><mxCell id="lengkap-tb_safe_zones-safe_zone_id" value="&lt;font color=&quot;#a16207&quot;&gt;&lt;b&gt;PK&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/b&gt;&lt;/font&gt;&lt;b&gt;safe_zone_id&amp;nbsp;&amp;nbsp;&lt;/b&gt;&lt;font color=&quot;#64748b&quot;&gt;INTEGER&amp;nbsp;&amp;nbsp;&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontFamily=Consolas;fontSize=12;whiteSpace=nowrap;" vertex="1" parent="lengkap-tb_safe_zones"><mxGeometry y="66" width="411" height="19" as="geometry"/></mxCell><mxCell id="lengkap-tb_safe_zones-nama_zona" value="&lt;font color=&quot;#a16207&quot;&gt;&lt;b&gt;FK&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/b&gt;&lt;/font&gt;nama_zona&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#64748b&quot;&gt;TEXT&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/font&gt;&lt;i&gt;&lt;font color=&quot;#475569&quot; face=&quot;Segoe UI&quot;&gt;nama kelurahan&lt;/font&gt;&lt;/i&gt;" style="text;html=1;strokeColor=none;fillColor=#f8fafc;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontFamily=Consolas;fontSize=12;whiteSpace=nowrap;" vertex="1" parent="lengkap-tb_safe_zones"><mxGeometry y="85" width="411" height="19" as="geometry"/></mxCell><mxCell id="lengkap-tb_safe_zones-elevasi_m" value="&lt;font color=&quot;#a16207&quot;&gt;&lt;b&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/b&gt;&lt;/font&gt;elevasi_m&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font color=&quo