ah, semuanya lolos syarat&lt;br&gt;arah. Urutan: terjauh dari pantai yang sempat &amp;lt;= 20 menit,&lt;br&gt;lalu tercepat. Rank 2/3 boleh NULL." style="text;html=1;fillColor=#f9ece7;strokeColor=none;align=left;verticalAlign=middle;spacingLeft=8;fontSize=10;fontFamily=Segoe UI;fontColor=#1e293b;whiteSpace=wrap;" vertex="1" parent="lengkap-tb_routes"><mxGeometry y="30" width="368" height="50" as="geometry"/></mxCell><mxCell id="lengkap-tb_routes-origin_node_id" value="&lt;font color=&quot;#a16207&quot;&gt;&lt;b&gt;PK,FK&amp;nbsp;&lt;/b&gt;&lt;/font&gt;&lt;b&gt;origin_node_id&amp;nbsp;&amp;nbsp;&lt;/b&gt;&lt;font color=&quot;#64748b&quot;&gt;INTEGER&amp;nbsp;&amp;nbsp;&lt;/font&gt;&lt;i&gt;&lt;font color=&quot;#475569&quot; face=&quot;Segoe UI&quot;&gt;simpul zona merah&lt;/font&gt;&lt;/i&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontFamily=Consolas;fontSize=12;whiteSpace=nowrap;" vertex="1" parent="lengkap-tb_routes"><mxGeometry y="80" width="368" height="19" as="geometry"/></mxCell><mxCell id="lengkap-tb_routes-rank_1_tes" value="&lt;font color=&quot;#a16207&quot;&gt;&lt;b&gt;FK&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/b&gt;&lt;/font&gt;rank_1_tes&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#64748b&quot;&gt;TEXT&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/font&gt;&lt;i&gt;&lt;font color=&quot;#475569&quot; face=&quot;Segoe UI&quot;&gt;nama TES&lt;/font&gt;&lt;/i&gt;" style="text;html=1;strokeColor=none;fillColor=#f8fafc;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontFamily=Consolas;fontSize=12;whiteSpace=nowrap;" vertex="1" parent="lengkap-tb_routes"><mxGeometry y="99" width="368" height="19" as="geometry"/></mxCell><mxCell id="lengkap-tb_routes-rank_1_path" value="&lt;font color=&quot;#a16207&quot;&gt;&