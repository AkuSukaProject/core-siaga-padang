"1" source="ringkas-tb_fasilitas_info-nearest_node_id" target="ringkas-tb_nodes-node_id"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ringkas-rel24" value="" style="edgeStyle=entityRelationEdgeStyle;html=1;rounded=0;fontSize=9;fontColor=#64748b;startArrow=ERzeroToOne;endArrow=ERmandOne;startFill=0;endFill=0;strokeColor=#c2410c;strokeWidth=1.3;" edge="1" parent="1" source="ringkas-tb_tes-tes_id" target="ringkas-tb_fasilitas_info-facility_id"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ringkas-rel25" value="" style="edgeStyle=entityRelationEdgeStyle;html=1;rounded=0;fontSize=9;fontColor=#64748b;startArrow=ERzeroToOne;endArrow=ERmandOne;startFill=0;endFill=0;strokeColor=#15803d;strokeWidth=1.3;" edge="1" parent="1" source="ringkas-tb_tea-tea_id" target="ringkas-tb_fasilitas_info-facility_id"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ringkas-rel26" value="" style="edgeStyle=entityRelationEdgeStyle;html=1;rounded=0;fontSize=9;fontColor=#64748b;startArrow=ERoneToMany;endArrow=ERzeroToOne;startFill=0;endFill=0;strokeColor=#6d28d9;strokeWidth=1.3;dashed=1;dashPattern=8 4;" edge="1" parent="1" source="ringkas-tb_node_info-kelurahan" target="ringkas-tb_kelurahan_info-kelurahan"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ringkas-rel27" value="" style="edgeStyle=entityRelationEdgeStyle;html=1;rounded=0;fontSize=9;fontColor=#64748b;startArrow=ERmandOne;endArrow=ERzeroToOne;startFill=0;endFill=0;strokeColor=#b91c1c;strokeWidth=1.3;dashed=1;dashPattern=8 4;" edge="1" parent="1" source="ringkas-tb_inundation_zones-nama_zona" target="ringkas-tb_kelurahan_info-kelurahan"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ringkas-rel28" value="" style="edgeStyle=entityRelationEdgeStyle;html=1;rounded=0;fontSize=9;fontColor=#64748b;startArrow=ERzeroToOne;endArrow=ERzeroToOne;startFill=0;endFill=0;strokeColor=#b91c1c;strokeWidth=1.3;dashed=1;dashPattern=8 4;" edge="1" parent="1" source="ringkas-tb_safe_zones-nama_zona" target="ringkas-tb_kelurahan_info-kelurahan"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ringkas-rel29" value="" style="edgeStyle=entityRelationEdgeStyle;html=1;rounded=0;fontSize=9;fontColor=#64748b;endArrow=open;startArrow=none;dashed=1;dashPattern=1 3;strokeColor=#c2410c;" edge="1" parent="1" source="ringkas-v_fasilitas_evakuasi-facility_id" target="ringkas-tb_tes-tes_id"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ringkas-rel30" value="" style="edgeStyle=entityRelationEdgeStyle;html=1;rounded=0;fontSize=9;fontColor=#64748b;endArrow=open;startArrow=none;dashed=1;dashPattern=1 3;strokeColor=#c2410c;" edge="1" parent="1" source="ringkas-v_fasilitas_evakuasi-facility_id" target="ringkas-tb_tea-tea_id"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ringkas-ket" value="&lt;b&gt;Keterangan&lt;/b&gt;&lt;br&gt;Warna kepala = kelompok tabel: &lt;font color=&quot;#475569&quot;&gt;&lt;b&gt;Graf jalan&lt;/b&gt;&lt;/font&gt;, &lt;font color=&quot;#c2410c&quot;&gt;&lt;b&gt;Rute TES (vertikal)&lt;/b&gt;&lt;/font&gt;, &lt;font color=&quot;#15803d&quot;&gt;&lt;b&gt;Rute TEA (horizontal)&lt;/b&gt;&lt;/font&gt;, &lt;font color=&quot;#0e7490&quot;&gt;&lt;b&gt;Rute zona aman&lt;/b&gt;&lt;/font&gt;, &lt;font color=&quot;#b91c1c&quot;&gt;&lt;b&gt;Zona spasial&lt;/b&gt;&lt;/font&gt;, &lt;font color=&quot;#6d28d9&quot;&gt;&lt;b&gt;Penugasan dan info engine&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Garis utuh = kunci ID; putus-putus = dicocokkan lewat nama; titik-titik = sumber VIEW. Ujung garis memakai notasi crow&#x27;s foot (kardinalitas dihitung dari isi DB). Semua relasi logis: SQLite tidak memakai foreign key.&lt;br&gt;PK = primary key, FK = merujuk tabel lain, UK = unik (target rujukan nama), NN = NOT NULL, APP = tabel dibaca aplikasi Android (commit 6ff41ed 2026-10-25)." style="text;html=1;fontSize=12;fontFamily=Segoe UI;align=left;verticalAlign=top;whiteSpace=wrap;fillColor=#f8fafc;strokeColor=#e2e8f0;rounded=1;arcSize=4;spacing=10;" vertex="1" parent="1"><mxGeometry x="40" y="981" width="1988" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
