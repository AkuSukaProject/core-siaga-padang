lative="1" as="geometry"/></mxCell><mxCell id="lengkap-rel27" value="" style="edgeStyle=entityRelationEdgeStyle;html=1;rounded=0;fontSize=9;fontColor=#64748b;startArrow=ERmandOne;endArrow=ERzeroToOne;startFill=0;endFill=0;strokeColor=#b91c1c;strokeWidth=1.3;dashed=1;dashPattern=8 4;" edge="1" parent="1" source="lengkap-tb_inundation_zones-nama_zona" target="lengkap-tb_kelurahan_info-kelurahan"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="lengkap-rel28" value="" style="edgeStyle=entityRelationEdgeStyle;html=1;rounded=0;fontSize=9;fontColor=#64748b;startArrow=ERzeroToOne;endArrow=ERzeroToOne;startFill=0;endFill=0;strokeColor=#b91c1c;strokeWidth=1.3;dashed=1;dashPattern=8 4;" edge="1" parent="1" source="lengkap-tb_safe_zones-nama_zona" target="lengkap-tb_kelurahan_info-kelurahan"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="lengkap-rel29" value="" style="edgeStyle=entityRelationEdgeStyle;html=1;rounded=0;fontSize=9;fontColor=#64748b;endArrow=open;startArrow=none;dashed=1;dashPattern=1 3;strokeColor=#c2410c;" edge="1" parent="1" source="lengkap-v_fasilitas_evakuasi-facility_id" target="lengkap-tb_tes-tes_id"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="lengkap-rel30" value="" style="edgeStyle=entityRelationEdgeStyle;html=1;rounded=0;fontSize=9;fontColor=#64748b;endArrow=open;startArrow=none;dashed=1;dashPattern=1 3;strokeColor=#c2410c;" edge="1" parent="1" source="lengkap-v_fasilitas_evakuasi-facility_id" target="lengkap-tb_tea-tea_id"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="lengkap-ket" value="&lt;b&gt;Keterangan&lt;/b&gt;&lt;br&gt;Warna kepala = kelompok tabel: &lt;font color=&quot;#475569&quot;&gt;&lt;b&gt;Graf jalan&lt;/b&gt;&lt;/font&gt;, &lt;font color=&quot;#c2410c&quot;&gt;&lt;b&gt;Rute TES (vertikal)&lt;/b&gt;&lt;/font&gt;, &lt;font color=&quot;#15803d&quot;&gt;&lt;b&gt;Rute TEA (horizontal)&lt;/b&gt;&lt;/font&gt;, &lt;font color=&quot;#0e7490&quot;&gt;&lt;b&gt;Rute zona aman&lt;/b&gt;&lt;/font&gt;, &lt;font color=&quot;#b91c1c&quot;&gt;&lt;b&gt;Zona spasial&lt;/b&gt;&lt;/font&gt;, &lt;font color=&quot;#6d28d9&quot;&gt;&lt;b&gt;Penugasan dan info engine&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Garis utuh = kunci ID; putus-putus = dicocokkan lewat nama; titik-titik = sumber VIEW. Ujung garis memakai notasi crow&#x27;s foot (kardinalitas dihitung dari isi DB). Semua relasi logis: SQLite tidak memakai foreign key.&lt;br&gt;PK = primary key, FK = merujuk tabel lain, UK = unik (target rujukan nama), NN = NOT NULL, APP = tabel dibaca aplikasi Android (commit 6ff41ed 2026-10-25)." style="text;html=1;fontSize=12;fontFamily=Segoe UI;align=left;verticalAlign=top;whiteSpace=wrap;fillColor=#f8fafc;strokeColor=#e2e8f0;rounded=1;arcSize=4;spacing=10;" vertex="1" parent="1"><mxGeometry x="40" y="1562" width="3024" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="ringkas" name="Ringkas"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2068" pageHeight="1131" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="ringkas-judul" value="&lt;b&gt;Entity Relationship Diagram: Basis Data Lokal Siaga Padang (ringkas)&lt;/b&gt;&lt;br&gt;ranah_siaga_v4.db versi 2026.10.16 | 20 tabel + 1 view, 153 kolom | 31.813 simpul, 39.216 ruas, 244 TES, 22 TEA, 68 poligon zona merah" style="text;html=1;fontSize=18;fontFamily=Segoe UI;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1988" height="70" as="geometry"/></mxCell><mxCell id="ringkas-tb_nodes" value="&lt;b&gt;tb_nodes&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;span style=&quot;font-size:10px;font-weight:normal&quot;&gt;31.813 baris · APP&lt;/span&gt;" style="swimlane;html=1;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=32;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;rounded=1;arcSize=3;f