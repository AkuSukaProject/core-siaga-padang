@startuml
' ERD basis data lokal Siaga Padang, ranah_siaga_v4.db versi 2026.10.17 (lengkap).
' Dibangkitkan oleh generate_erd_gambar.py dari DB; jangan diedit manual.
' Relasi logis (SQLite tanpa foreign key); kardinalitas dihitung dari isi DB.
' * = PK atau NOT NULL. Garis utuh = kunci ID, putus-putus = lewat nama / kunci kelompok / sumber VIEW.
hide circle
hide stereotype
skinparam linetype ortho
skinparam shadowing false
skinparam defaultFontName Consolas
skinparam nodesep 40
skinparam ranksep 60
skinparam entity {
  FontStyle bold
  FontSize 13
  AttributeFontSize 11
}
skinparam package {
  FontStyle bold
  BorderColor #CBD5E1
}
skinparam entity {
  BackgroundColor<<graf>> #f2f3f4
  BorderColor<<graf>> #475569
  FontColor<<graf>> #475569
}
skinparam entity {
  BackgroundColor<<tes>> #fbf2ee
  BorderColor<<tes>> #c2410c
  FontColor<<tes>> #c2410c
}
skinparam entity {
  BackgroundColor<<tea>> #eff6f1
  BorderColor<<tea>> #15803d
  FontColor<<tea>> #15803d
}
skinparam entity {
  BackgroundColor<<aman>> #eef5f7
  BorderColor<<aman>> #0e7490
  FontColor<<aman>> #0e7490
}
skinparam entity {
  BackgroundColor<<zona>> #faefef
  BorderColor<<zona>> #b91c1c
  FontColor<<zona>> #b91c1c
}
skinparam entity {
  BackgroundColor<<info>> #f5f0fc
  BorderColor<<info>> #6d28d9
  FontColor<<info>> #6d28d9
}

title Basis Data Lokal Siaga Padang (ranah_siaga_v4.db versi 2026.10.17)

package "Graf jalan" {
  entity "tb_edges\n<size:10><color:#64748b>39.267 baris · APP</color></size>" as tb_edges <<graf>> {
    <size:10><i>Ruas jalan tak berarah untuk menggambar rute; 390 pasangan</i></size>
    <size:10><i>u-v punya lebih dari satu ruas (jalan sejajar).</i></size>
    ..
    * edge_id : INTEGER <<PK>> <color:#64748b><size:10>nomor ruas (diberi ulang tiap build)</size></color>
    --
    u : INTEGER <<FK>> <color:#64748b><size:10>simpul ujung</size></color>
    v : INTEGER <<FK>> <color:#64748b><size:10>simpul ujung</size></color>
    length : REAL <color:#64748b><size:10>meter</size></color>
    geometry : TEXT <color:#64748b><size:10>WKT LineString (lon lat)</size></color>
  }
  entity "tb_bridge_edges\n<size:10><color:#64748b>174 baris · APP</color></size>" as tb_bridge_edges <<graf>> {
    <size:10><i>Ruas yang memuat badan jembatan ≥ 20 m (OSM). Rute lewat</i></size>
    <size:10><i>jembatan hanya dipakai bila tidak ada pilihan lain.</i></size>
    ..
    * edge_id : INTEGER <<PK,FK>> <color:#64748b><size:10>ruas berjembatan</size></color>
  }
  entity "tb_jalur_resmi\n<size:10><color:#64748b>4.984 baris</color></size>" as tb_jalur_resmi <<graf>> {
    <size:10><i>Ruas graf yang berimpit dengan jalur evakuasi resmi BPBD</i></size>
    <size:10><i>(Jalur_evakuasi_Padang.shp); biayanya dikali 0,8.</i></size>
    ..
    * u : INTEGER <<PK,FK>> <color:#64748b><size:10>simpul ujung</size></color>
    * v : INTEGER <<PK,FK>> <color:#64748b><size:10>simpul ujung</size></color>
  }
  entity "tb_nodes\n<size:10><color:#64748b>31.859 baris · APP</color></size>" as tb_nodes <<graf>> {
    <size:10><i>Simpul graf jalan pejalan kaki OSM (OSM per 2026-10-20).</i></size>
    <size:10><i>is_safe sama persis dengan poligon zona merah: 11.438 merah,</i></size>
    <size:10><i>20.421 hijau.</i></size>
    ..
    * node_id : INTEGER <<PK>> <color:#64748b><size:10>ID simpul OSM (tetap antar-build)</size></color>
    --
    lat : REAL <color:#64748b><size:10>WGS 84</size></color>
    lon : REAL <color:#64748b><size:10>WGS 84</size></color>
    is_safe : INTEGER <color:#64748b><size:10>0 = zona merah, 1 = zona hijau</size></color>
    jarak_pantai_m : INTEGER <color:#64748b><size:10>m ke garis pantai OSM (bulat)</size></color>
  }
}

package "Rute TES (vertikal)" {
  entity "tb_tes\n<size:10><color:#64748b>244 baris · APP</color></size>" as tb_tes <<tes>> {
    <size:10><i>TES (evakuasi vertikal) yang dipakai routing: 45 sumber</i></size>
    <size:10><i>BPBD, 199 kesepakatan warga. Nama unik.</i></size>
    ..
    * tes_id : TEXT <<PK,FK>> <color:#64748b><size:10>TES_001 ...</size></color>
    --
    nama_tes : TEXT <<UK>> <color:#64748b><size:10>unik; dirujuk rank_k_tes</size></color>
    zona : TEXT <color:#64748b><size:10>nama kelurahan</size></color>
    kapasitas : REAL <color:#64748b><size:10>jiwa; NULL = tidak ada data</size></color>
    lat : REAL <color:#64748b><size:10>WGS 84</size></color>
    lon : REAL <color:#64748b><size:10>WGS 84</size></color>
    sumber : TEXT <color:#64748b><size:10>BPBD / WARGA</size></color>
    jarak_pantai_m : INTEGER <color:#64748b><size:10>m ke garis pantai</size></color>
    lantai : INTEGER <color:#64748b><size:10>jumlah lantai</size></color>
  }
  entity "tb_routes\n<size:10><color:#64748b>10.708 baris · APP</color></size>" as tb_routes <<tes>> {
    <size:10><i>Hingga 3 TES per simpul zona merah, semuanya lolos syarat</i></size>
    <size:10><i>arah. Urutan: terjauh dari pantai yang sempat ≤ 20 menit,</i></size>
    <size:10><i>lalu tercepat. Rank 2/3 boleh NULL.</i></size>
    ..
    * origin_node_id : INTEGER <<PK,FK>> <color:#64748b><size:10>simpul zona merah</size></color>
    --
    rank_1_tes : TEXT <<FK>> <color:#64748b><size:10>nama TES</size></color>
    rank_1_path : TEXT <color:#64748b><size:10>ID simpul dipisah koma</size></color>
    rank_1_eta : REAL <color:#64748b><size:10>menit pada 1,2 m/s</size></color>
    rank_2_tes : TEXT <<FK>> <color:#64748b><size:10>boleh NULL</size></color>
    rank_2_path : TEXT
    rank_2_eta : REAL
    rank_3_tes : TEXT <<FK>> <color:#64748b><size:10>boleh NULL</size></color>
    rank_3_path : TEXT
    rank_3_eta : REAL
  }
  entity "v_fasilitas_evakuasi\n<size:10><color:#64748b>266 baris · VIEW · APP</color></size>" as v_fasilitas_evakuasi <<tes>> {
    <size:10><i>VIEW gabungan tb_tes (Vertikal) dan tb_tea (Horizontal)</i></size>
    <size:10><i>untuk daftar dan peta fasilitas.</i></size>
    ..
    facility_id : TEXT <color:#64748b><size:10>tes_id / tea_id</size></color>
    kode : TEXT <color:#64748b><size:10>tes_id / kode_tea</size></color>
    nama : TEXT <color:#64748b><size:10>nama_tes / nama_tea</size></color>
    jenis : - <color:#64748b><size:10>'TES' / 'TEA'</size></color>
    tipe_evakuasi : - <color:#64748b><size:10>'Vertikal' / 'Horizontal'</size></color>
    zona_sektor : TEXT <color:#64748b><size:10>zona / sektor</size></color>
    kapasitas : REAL
    lat : REAL
    lon : REAL
    sumber : TEXT
  }
}

package "Rute TEA (horizontal)" {
  entity "tb_tea\n<size:10><color:#64748b>22 baris · APP</color></size>" as tb_tea <<tea>> {
    <size:10><i>TEA (evakuasi horizontal) di luar zona merah. kapasitas 0 =</i></size>
    <size:10><i>tidak ada data; TEA tidak dibatasi kapasitas saat routing.</i></size>
    ..
    * tea_id : TEXT <<PK,FK>> <color:#64748b><size:10>TEA_001 ...</size></color>
    --
    * kode_tea : TEXT
    * sektor : TEXT <color:#64748b><size:10>kecamatan</size></color>
    * nama_tea : TEXT <<UK>> <color:#64748b><size:10>unik</size></color>
    kelurahan : TEXT <color:#64748b><size:10>nama kelurahan</size></color>
    kecamatan : TEXT
    tipe_fasilitas : TEXT <color:#64748b><size:10>'TEA'</size></color>
    * kapasitas : REAL <color:#64748b><size:10>0 = tidak ada data</size></color>
    * lat : REAL <color:#64748b><size:10>WGS 84</size></color>
    * lon : REAL <color:#64748b><size:10>WGS 84</size></color>
    nearest_node_id : INTEGER <<FK>> <color:#64748b><size:10>simpul tujuan rute</size></color>
    rute_evakuasi : TEXT <color:#64748b><size:10>NULL (cadangan)</size></color>
    jarak_pantai_m : INTEGER <color:#64748b><size:10>m ke garis pantai</size></color>
    sumber : TEXT <color:#64748b><size:10>BPBD / WARGA</size></color>
  }
  entity "tb_tea_routes\n<size:10><color:#64748b>22.125 baris · APP</color></size>" as tb_tea_routes <<tea>> {
    <size:10><i>TEA utama dan alternatif untuk setiap simpul (11.428 merah,</i></size>
    <size:10><i>10.697 hijau); urutan sama dengan TES. alt = utama bila</i></size>
    <size:10><i>tidak ada TEA lain yang layak.</i></size>
    ..
    * origin_node_id : INTEGER <<PK,FK>> <color:#64748b><size:10>simpul asal</size></color>
    --
    nearest_tea_id : TEXT <<FK>> <color:#64748b><size:10>TEA utama</size></color>
    alt_tea_id : TEXT <<FK>> <color:#64748b><size:10>TEA alternatif</size></color>
  }
  entity "tb_tea_next\n<size:10><color:#64748b>47.131 baris · APP</color></size>" as tb_tea_next <<tea>> {
    <size:10><i>Pohon next-hop per TEA: dari node_id lanjut ke next_node_id,</i></size>
    <size:10><i>diulang sampai nearest_node_id TEA.</i></size>
    ..
    * tea_id : TEXT <<PK,FK>> <color:#64748b><size:10>pohon milik TEA</size></color>
    * node_id : INTEGER <<PK,FK>> <color:#64748b><size:10>simpul sekarang</size></color>
    --
    * next_node_id : INTEGER <<FK>> <color:#64748b><size:10>langkah berikutnya</size></color>
  }
}

package "Rute zona aman" {
  entity "tb_safe_routes_v2\n<size:10><color:#64748b>11.438 baris · APP</color></size>" as tb_safe_routes_v2 <<aman>> {
    <size:10><i>Navigasi zona aman K-B6 untuk semua simpul merah: titik zona</i></size>
    <size:10><i>hijau terjauh dari pantai yang sempat ≤ 15 menit; bila tidak</i></size>
    <size:10><i>ada, batas zona hijau tercepat.</i></size>
    ..
    * origin_node_id : INTEGER <<PK,FK>> <color:#64748b><size:10>simpul zona merah</size></color>
    --
    * kelompok : INTEGER <<FK>> <color:#64748b><size:10>ID pohon tujuan</size></color>
    * safe_node_id : INTEGER <<FK>> <color:#64748b><size:10>titik tujuan di zona hijau</size></color>
    safe_zone_nama : TEXT <color:#64748b><size:10>'Zona Aman - ‹kelurahan›'</size></color>
    safe_eta : REAL <color:#64748b><size:10>menit pada 1,2 m/s</size></color>
    safe_d_pantai_m : REAL <color:#64748b><size:10>jarak pantai tujuan</size></color>
    mendekat_pantai_maks_m : REAL <color:#64748b><size:10>maks. mendekat pantai di rute</size></color>
    safe_zone_id : INTEGER <<FK>> <color:#64748b><size:10>NULL bila di luar poligon</size></color>
  }
  entity "tb_safe_next_v2\n<size:10><color:#64748b>28.985 baris · APP</color></size>" as tb_safe_next_v2 <<aman>> {
    <size:10><i>Pohon next-hop menuju titik tujuan v2, satu pohon per</i></size>
    <size:10><i>kelompok (862 kelompok).</i></size>
    ..
    * kelompok : INTEGER <<PK>> <color:#64748b><size:10>pohon milik titik tujuan</size></color>
    * node_id : INTEGER <<PK,FK>> <color:#64748b><size:10>simpul sekarang</size></color>
    --
    * next_node_id : INTEGER <<FK>> <color:#64748b><size:10>langkah berikutnya</size></color>
  }
  entity "tb_safe_routes\n<size:10><color:#64748b>30.884 baris · APP</color></size>" as tb_safe_routes <<aman>> {
    <size:10><i>Kontrak lama: batas zona hijau terdekat dari satu pohon</i></size>
    <size:10><i>global. safe_eta = 0 berarti sudah di zona hijau (status</i></size>
    <size:10><i>tiba). Simpul merah hanya yang tujuannya lolos syarat arah.</i></size>
    ..
    * origin_node_id : INTEGER <<PK,FK>> <color:#64748b><size:10>semua simpul</size></color>
    --
    safe_node_id : INTEGER <<FK>> <color:#64748b><size:10>batas zona hijau</size></color>
    safe_zone_nama : TEXT <color:#64748b><size:10>'Zona Aman - ‹kelurahan›'</size></color>
    safe_eta : REAL <color:#64748b><size:10>menit; 0 = di zona hijau</size></color>
    safe_zone_id : INTEGER <<FK>> <color:#64748b><size:10>NULL bila di luar poligon</size></color>
  }
  entity "tb_safe_next\n<size:10><color:#64748b>10.631 baris · APP</color></size>" as tb_safe_next <<aman>> {
    <size:10><i>Next-hop pohon global tb_safe_routes.</i></size>
    ..
    * node_id : INTEGER <<PK,FK>> <color:#64748b><size:10>simpul sekarang</size></color>
    * next_node_id : INTEGER <<PK,FK>> <color:#64748b><size:10>langkah berikutnya</size></color>
  }
}

