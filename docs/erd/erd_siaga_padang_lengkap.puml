package "Penugasan dan info engine" {
  entity "tb_fasilitas_info\n<size:10><color:#64748b>294 baris</color></size>" as tb_fasilitas_info <<info>> {
    <size:10><i>Semua TES/TEA sumber (294), termasuk 28 yang tidak dipakai</i></size>
    <size:10><i>beserta alasannya, sumber kapasitas, dan sumber koordinat.</i></size>
