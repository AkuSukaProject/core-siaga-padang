tb_edges }|--|| tb_nodes : "u, v → node_id"
tb_bridge_edges |o--|| tb_edges : "edge_id → edge_id"
tb_jalur_resmi }o--|| tb_nodes : "u, v → node_id"
tb_node_info ||--|| tb_nodes : "node_id → node_id"
tb_routes |o--|| tb_nodes : "origin_node_id → node_id"
